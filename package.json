{
  "name": "flowforge",
  "version": "1.0.0",
  "description": "AI Workflow Automation Platform - Democratizing AI automation for business users",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run dev",
    "build": "npm run build:shared && npm run build:web && npm run build:api",
    "build:shared": "cd packages/shared && npm run build",
    "build:web": "cd apps/web && npm run build",
    "build:api": "cd apps/api && npm run build",
    "install:all": "npm install && cd packages/shared && npm install && cd ../../apps/web && npm install && cd ../api && npm install",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "ai",
    "automation",
    "workflow",
    "no-code",
    "business-process",
    "integration",
    "saas"
  ],
  "author": "FlowForge Team",
  "license": "MIT",
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "reactflow": "^11.11.4",
    "uuid": "^11.1.0"
  }
}
