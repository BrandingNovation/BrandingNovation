# FlowForge Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# Application
NODE_ENV=production
APP_NAME=FlowForge
APP_VERSION=1.0.0
APP_URL=https://flowforge.com

# Database Configuration
POSTGRES_DB=flowforge_prod
POSTGRES_USER=flowforge_admin
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
DATABASE_URL=postgresql://flowforge_admin:CHANGE_THIS_STRONG_PASSWORD_123!@postgres:5432/flowforge_prod

# MongoDB Configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_THIS_MONGO_PASSWORD_456!
MONGODB_URL=mongodb://admin:CHANGE_THIS_MONGO_PASSWORD_456!@mongo:27017/flowforge

# Redis Configuration
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_789!
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD_789!@redis:6379

# Security
JWT_SECRET=CHANGE_THIS_JWT_SECRET_SUPER_LONG_RANDOM_STRING_987654321
ENCRYPTION_KEY=CHANGE_THIS_ENCRYPTION_KEY_256_BIT_HEX_STRING

# Payment Processing
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLIC_KEY=pk_live_YOUR_STRIPE_PUBLIC_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# AI Services
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Email Service
SENDGRID_API_KEY=SG.YOUR_SENDGRID_API_KEY
FROM_EMAIL=noreply@flowforge.com
SUPPORT_EMAIL=support@flowforge.com

# AWS Configuration
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=flowforge-production-assets

# Google Services
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GA_TRACKING_ID=G-YOUR_ANALYTICS_ID

# Monitoring & Error Tracking
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID
NEW_RELIC_LICENSE_KEY=YOUR_NEW_RELIC_KEY
DATADOG_API_KEY=YOUR_DATADOG_API_KEY

# Monitoring Passwords
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# SSL Configuration
SSL_CERT_PATH=/etc/ssl/certs/flowforge.crt
SSL_KEY_PATH=/etc/ssl/certs/flowforge.key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET_RANDOM_STRING
SESSION_TIMEOUT=24h

# Feature Flags
ENABLE_AI_GENERATION=true
ENABLE_REAL_TIME_COLLABORATION=true
ENABLE_ANALYTICS=true
ENABLE_PAYMENT_PROCESSING=true
ENABLE_WEBHOOKS=true

# Business Configuration
COMPANY_NAME=FlowForge Inc.
COMPANY_EMAIL=hello@flowforge.com
COMPANY_ADDRESS=123 Innovation Drive, San Francisco, CA 94105
COMPANY_PHONE=+1-555-FLOWFORGE

# Subscription Plans
BASIC_PLAN_PRICE_ID=price_STRIPE_BASIC_PLAN_ID
PRO_PLAN_PRICE_ID=price_STRIPE_PRO_PLAN_ID
ENTERPRISE_PLAN_PRICE_ID=price_STRIPE_ENTERPRISE_PLAN_ID

# Limits
MAX_WORKFLOWS_BASIC=10
MAX_WORKFLOWS_PRO=100
MAX_WORKFLOWS_ENTERPRISE=unlimited
MAX_EXECUTIONS_BASIC=1000
MAX_EXECUTIONS_PRO=10000
MAX_EXECUTIONS_ENTERPRISE=unlimited

# External Integrations
SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/YOUR_WEBHOOK
HUBSPOT_API_KEY=YOUR_HUBSPOT_API_KEY

# CDN Configuration
CDN_URL=https://cdn.flowforge.com
ASSETS_URL=https://assets.flowforge.com

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
S3_BACKUP_BUCKET=flowforge-backups

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DESTINATION=file

# Security Headers
ENABLE_HELMET=true
ENABLE_CORS=true
CORS_ORIGIN=https://flowforge.com,https://www.flowforge.com
ENABLE_RATE_LIMITING=true

# Health Checks
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3